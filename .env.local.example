# ─────────────────────────────────────────────────────────────────────────────
# Tandem environment configuration
# Copy this file to `.env.local` and fill in the values you need.
#   cp .env.local.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# Which LLM provider Tandem talks to. One of: gemini | ollama | openai
# Switching providers requires changing ONLY this variable — no code edits.
LLM_PROVIDER=gemini

# ── Gemini (default) ─────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ── Ollama (local) ───────────────────────────────────────────────────────────
# Base URL of your running Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
# Model to use (must be pulled first, e.g. `ollama pull qwen2.5:7b`).
OLLAMA_MODEL=qwen2.5:7b

# ── OpenAI (optional) ────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Optional: override the OpenAI model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ── Dispatch ─────────────────────────────────────────────────────────────────
# How approved prompts are handed off. One of: file-queue | claude-cli | terminal
#   file-queue → writes a timestamped .md file (a watcher consumes it)
#   terminal   → opens an INTERACTIVE Claude Code session in Terminal.app so you
#                approve/reject changes live (recommended for hands-on use)
#   claude-cli → runs `claude -p` headless/auto-accept, output to a log (no
#                interactive approval — for trusted, fire-and-forget runs)
# terminal and claude-cli both use your Claude subscription login when no
# ANTHROPIC_API_KEY is set.
TANDEM_DISPATCHER=file-queue

# Directory where approved prompts (file-queue) and run logs (claude-cli) land.
TANDEM_QUEUE_DIR=./tandem-queue

# ── claude-cli dispatcher options (only used when TANDEM_DISPATCHER=claude-cli)
# Directory Claude Code runs in (where it reads/writes files). Defaults to CWD.
TANDEM_CLAUDE_CWD=
# Path to the claude binary if it's not on PATH (default: "claude").
TANDEM_CLAUDE_BIN=
# Permission mode so Claude can edit files autonomously in headless print mode
# (claude-cli only). e.g. acceptEdits | plan | bypassPermissions. Empty = CLI
# default (pauses at the first action needing approval). Use bypassPermissions
# with caution.
TANDEM_CLAUDE_PERMISSION_MODE=
# Linux only (terminal dispatcher): force a specific terminal emulator, e.g.
# gnome-terminal | konsole | xterm. Empty = auto-detect.
TANDEM_TERMINAL=

# ── Debug ────────────────────────────────────────────────────────────────────
# Set to 1 to log the exact messages sent to the model (including the system
# prompt) and the raw model response to the `npm run dev` terminal.
TANDEM_DEBUG=0
